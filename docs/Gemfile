# GitHub Pages 的 Jekyll 构建依赖
#
# 注意：这些依赖只用于**构建文档站**，与 Python 包本身的依赖完全无关。
# 用户安装本项目时不会拉到这些 gem。

source "https://rubygems.org"

# 注意：GitHub Pages 只允许官方白名单内的插件。
# jekyll-relative-links / jekyll-optional-front-matter / jekyll-readme-index
# 都不在白名单里，线上构建会失败，因此这里不声明它们。
gem "jekyll", "~> 4.3"
gem "jekyll-feed", "~> 0.17"
gem "jekyll-seo-tag", "~> 2.8"

# Windows/JRuby 上需要
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "webrick", "~> 1.8"
