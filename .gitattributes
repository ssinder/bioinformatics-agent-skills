# 默认按文本处理，仓库内统一使用 LF
* text=auto eol=lf

# Python 脚本
*.py text eol=lf

# 脚本与配置
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# 文档
*.md text eol=lf
*.cff text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.dcd binary
*.pdb binary
*.cif binary
*.h5ad binary
*.npz binary
